# CortexFi MIE Environment Variables Example

PROJECT_NAME="CortexFi Market Intelligence Engine"
DEBUG=true
LOG_LEVEL="INFO"

# CMIS Scoring Parameters
CMIS_EMISSION_THRESHOLD=70.0
WHALE_TRANSFER_MIN_USD=1000000.0
FUNDING_RATE_EXTREME_THRESHOLD=0.0003
OI_SPIKE_PERCENT_THRESHOLD=5.0

# Database URLs
POSTGRES_URI="postgresql+asyncpg://postgres:postgres@localhost:5432/cortexfi"
REDIS_URI="redis://localhost:6379/0"

# LLM Keys (Optional for live LLM providers)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Delivery
WEBHOOK_URL="https://api.cortexfi.io/v1/alerts/webhook"
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHANNEL_ID="@CortexFiSignals"
