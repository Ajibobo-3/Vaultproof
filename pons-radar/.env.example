# ============================================================
# PonsRadar ($RADAR) — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Robinhood Chain RPC (REQUIRED) ---
# Primary HTTP RPC endpoint for Robinhood Chain (Chain ID: 4663)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: WebSocket RPC for live event subscription
# WS_URL=wss://ws.mainnet.chain.robinhood.com

# --- Pons Factory Contract (REQUIRED) ---
FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# --- Telegram Bot (REQUIRED) ---
# Obtain your bot token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel ID where public alerts are broadcast (must start with -100...)
# To find it: forward a message from your channel to @userinfobot
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# Optional: Comma-separated Telegram user IDs granted admin commands
# ADMIN_IDS=123456789,987654321

# --- Graduation Threshold (ETH) ---
# ETH amount at which a bonding curve graduates to Uniswap V4
GRADUATION_ETH=4.2

# --- Polling Interval ---
# How often (in seconds) the monitor checks all active curves (10–30 recommended)
POLL_INTERVAL_SECONDS=15

# --- Block Polling Fallback ---
# Number of blocks to scan on startup to catch any missed TokenCreated events
BLOCK_LOOKBACK=500

# --- SQLite Database Path ---
DB_PATH=./data/pons-radar.db

# --- Log Level ---
# Options: debug | info | warn | error
LOG_LEVEL=info
